# Deny the entire build context, then admit only reviewed runtime inputs.
# This is an image-context policy, not permission to publish the Git repository.
**
!Dockerfile
!.dockerignore
!requirements.txt
!src/
src/**
!src/citypilot/
src/citypilot/**
!src/citypilot/__init__.py
!src/citypilot/api.py
!src/citypilot/api_decision.py
!src/citypilot/api_routing.py
!src/citypilot/contracts.py
!src/citypilot/decision_engine.py
!src/citypilot/routing_engine.py
!supplements/
supplements/**
!supplements/m_services_v1/
supplements/m_services_v1/**
!supplements/m_services_v1/config/
supplements/m_services_v1/config/**
!supplements/m_services_v1/config/limits.yaml
!supplements/m_services_v1/config/prebuilt_services/
supplements/m_services_v1/config/prebuilt_services/**
!supplements/m_services_v1/config/prebuilt_services/assets.json
!supplements/m_services_v1/config/prebuilt_services/manifest.json
!config/
config/**
!config/objective/
config/objective/**
!config/objective/objective_decision_P.json
!config/objective/objective_decision_B.json
!config/objective/m_services_v1/
config/objective/m_services_v1/**
!config/objective/m_services_v1/objective_decision_P.json
!config/objective/m_services_v1/objective_decision_B.json

# Defense in depth: later allowlist additions must not admit these inputs.
**/.git
**/.git/**
**/.env
**/.env.*
**/.aws/**
**/.codex/**
**/.agents/**
**/.docker/**
**/.ssh/**
**/*credentials*
**/*secret*
**/*token*
**/*.pem
**/*.key
**/__pycache__/**
**/.venv/**
**/venv/**
**/citypilot-env/**
**/node_modules/**
**/*backup*
**/*.bak
**/*.zip
**/*.tar
**/*.gz
**/*.7z
notebooks/**
data/**
datasets/**
outputs/**
web/**
